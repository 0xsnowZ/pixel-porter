; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pixel Porter"
run/main_scene="res://scenes/splash_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.0235294, 0.0352941, 0.0666667, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/minimum_display_time=1200
config/icon="res://icon.png"

[autoload]

SaveManager="*res://scripts/save_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
LocalizationManager="*res://scripts/localization_manager.gd"
AdManager="*res://scripts/ad_manager.gd"
HapticManager="*res://scripts/haptic_manager.gd"
SafeAreaManager="*res://scripts/safe_area_manager.gd"
AchievementManager="*res://scripts/achievement_manager.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/theme.tres"
